# ==============================================================
# HATE & TOXICITY SENTINEL PLATFORM - CONFIGURATION TEMPLATE
# ==============================================================

# Application Meta
PROJECT_NAME="Hate & Toxicity Sentinel Platform"
PROJECT_DESCRIPTION="Automated Extraction and Preprocessing of Live Forums for Early Identification of Hate Speech and Toxic Trends"
VERSION="1.0.0"

# Security & Authentication (Generate secure secret in production)
SECRET_KEY="sentinel-super-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default zero-config SQLite:
DATABASE_URL="sqlite:///./backend/data/platform.db"
# Or PostgreSQL for production / Docker:
# DATABASE_URL="postgresql://sentinel_user:sentinel_secret_2026@localhost:5432/sentinel_db"

# Initial Default Administrator (Created safely on first launch)
DEFAULT_ADMIN_EMAIL="admin@sentinel.ai"
DEFAULT_ADMIN_PASSWORD="Admin@Sentinel2026"
DEFAULT_ADMIN_NAME="System Administrator"

# Live Simulation Interval
SIMULATION_INTERVAL_SECONDS=2.0

# Optional Reddit External Source API (Mode A)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="sentinel-monitor-v1.0"
